# Image for builds and tests. Arch as the target system: a fresh keepassxc-cli for compatibility tests.
# Run through the Makefile with a memory limit.
FROM archlinux:latest

# GPUI system libraries + keepassxc-cli + wl-clipboard and headless sway (clipboard tests) + openssh (agent tests)
# + software Vulkan (lavapipe), grim and fonts: the UI runs in headless sway and is screenshotted
# + chromium and node: extension e2e (playwright-core, headless Chromium with real native messaging)
RUN pacman -Syu --noconfirm --needed \
      base-devel rustup clang pkgconf fontconfig wayland libxkbcommon libxkbcommon-x11 \
      libxcb vulkan-icd-loader vulkan-swrast grim wtype noto-fonts chromium nodejs npm openssl zstd keepassxc wl-clipboard openssh git sway \
    && pacman -Scc --noconfirm

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN rustup default stable \
    && rustup target add wasm32-unknown-unknown \
    && rustup component add clippy rustfmt \
    && cargo install wasm-bindgen-cli --version 0.2.130 --locked \
    && rm -rf /opt/cargo/registry \
    && chmod -R a+rwX /opt/rustup

# pdftoppm: PDF attachment preview (separate layer so the whole image is not rebuilt)
RUN pacman -Syu --noconfirm --needed poppler && pacman -Scc --noconfirm

# Cross-platform: build checks for Windows and macOS (cargo check, no linking)
RUN rustup target add x86_64-pc-windows-msvc x86_64-pc-windows-gnu aarch64-apple-darwin \
    && pacman -Syu --noconfirm --needed mingw-w64-gcc && pacman -Scc --noconfirm \
    && chmod -R a+rwX /opt/rustup

# zig as the macOS C compiler (builds C dependencies like ring without Xcode)
RUN pacman -Syu --noconfirm --needed zig && pacman -Scc --noconfirm
COPY bin/zigcc-macos /usr/local/bin/zigcc-macos
