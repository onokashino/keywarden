#!/bin/sh
# C compiler for macOS build checks from Linux (ring and the like): zig ships the macOS headers.
# cc-rs passes its own --target, zig understands only -target: drop it.
args=""
for a in "$@"; do
  case "$a" in
    --target=*|-mmacosx-version-min=*) ;;
    *) args="$args '$(printf %s "$a" | sed "s/'/'\\\\''/g")'" ;;
  esac
done
eval exec zig cc -target aarch64-macos $args
