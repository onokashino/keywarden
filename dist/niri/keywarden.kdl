// Keywarden for niri. The installer adds this line to ~/.config/niri/config.kdl:
//   include "keywarden.kdl"
// Shortcuts taken? Change them here; niri reloads the config by itself.

binds {
    // launcher: search and copy a password over any window
    Mod+Shift+P hotkey-overlay-title="Keywarden: passwords" { spawn "keywarden-ui" "--launcher"; }
    // autotype into the active window: username, Tab, password, Enter (or the entry's sequence)
    Mod+Shift+A hotkey-overlay-title="Keywarden: autotype" { spawn "kw" "autotype"; }
    // lock the vault
    Mod+Shift+Alt+L hotkey-overlay-title="Keywarden: lock" { spawn "kw" "lock"; }
}

// the main window opens floating
window-rule {
    match app-id="^keywarden$"
    open-floating true
    default-column-width { fixed 1200; }
}

// launcher: a shadow like other windows
layer-rule {
    match namespace="^keywarden-launcher$"
    shadow { on; }
}
