[Unit]
Description=Keywarden password manager daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/keywardend
# WAYLAND_DISPLAY для буфера обмена приходит из сессии niri (systemctl --user import-environment)
Restart=on-failure
# секреты не должны уходить в своп, а дампы не должны создаваться
LimitCORE=0
LimitMEMLOCK=infinity
MemorySwapMax=0
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
