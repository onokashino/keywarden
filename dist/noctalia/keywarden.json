{
  "$schema": "https://gpui-kit.com/schema/theme.json",
  "name": "Noctalia",
  "author": "Keywarden (шаблон Noctalia, сгенерировано автоматически)",
  "themes": [
    {
      "name": "Noctalia",
      "mode": "{{ mode }}",
      "colors": {
        "background": "{{colors.surface.default.hex}}",
        "foreground": "{{colors.on_surface.default.hex}}",
        "border": "{{colors.outline.default.hex}}40",
        "window.border": "{{colors.outline.default.hex}}40",
        "overlay": "#00000080",
        "ring": "{{colors.primary.default.hex}}",
        "caret": "{{colors.primary.default.hex}}",
        "selection.background": "{{colors.primary.default.hex}}4d",
        "input.border": "{{colors.outline.default.hex}}80",

        "muted.background": "{{colors.surface_container_high.default.hex}}",
        "muted.foreground": "{{colors.on_surface_variant.default.hex}}",
        "accent.background": "{{colors.surface_container_high.default.hex}}",
        "accent.foreground": "{{colors.on_surface.default.hex}}",

        "primary.background": "{{colors.primary.default.hex}}",
        "primary.foreground": "{{colors.on_primary.default.hex}}",
        "primary.hover.background": "{{colors.primary.default.hex}}e6",
        "primary.active.background": "{{colors.primary.default.hex}}cc",
        "secondary.background": "{{colors.surface_container_high.default.hex}}",
        "secondary.foreground": "{{colors.on_surface.default.hex}}",
        "secondary.hover.background": "{{colors.surface_variant.default.hex}}",
        "secondary.active.background": "{{colors.surface_variant.default.hex}}cc",

        "danger.background": "{{colors.error.default.hex}}",
        "danger.foreground": "{{colors.error.default.hex}}",
        "success.background": "{{colors.terminal_normal_green.default.hex}}",
        "success.foreground": "{{colors.terminal_normal_green.default.hex}}",
        "warning.background": "{{colors.terminal_normal_yellow.default.hex}}",
        "warning.foreground": "{{colors.terminal_normal_yellow.default.hex}}",
        "info.background": "{{colors.terminal_normal_cyan.default.hex}}",
        "info.foreground": "{{colors.terminal_normal_cyan.default.hex}}",
        "link.foreground": "{{colors.primary.default.hex}}",
        "link.hover.foreground": "{{colors.primary.default.hex}}",
        "link.active.foreground": "{{colors.primary.default.hex}}cc",

        "list.background": "{{colors.surface.default.hex}}",
        "list.active.background": "{{colors.primary.default.hex}}26",
        "list.active.border": "{{colors.primary.default.hex}}",
        "list.even.background": "{{colors.surface_container_low.default.hex}}",
        "list.head.background": "{{colors.surface_container.default.hex}}",
        "popover.background": "{{colors.surface_container.default.hex}}",
        "popover.foreground": "{{colors.on_surface.default.hex}}",
        "description_list_label.background": "{{colors.surface_container.default.hex}}",
        "description_list_label.foreground": "{{colors.on_surface_variant.default.hex}}",
        "group_box.background": "{{colors.surface_container_low.default.hex}}",
        "group_box.foreground": "{{colors.on_surface.default.hex}}",
        "accordion.background": "{{colors.surface_container_low.default.hex}}",

        "sidebar.background": "{{colors.surface_container_low.default.hex}}",
        "sidebar.foreground": "{{colors.on_surface.default.hex}}",
        "sidebar.border": "{{colors.outline.default.hex}}33",
        "sidebar.accent.background": "{{colors.surface_container_high.default.hex}}",
        "sidebar.accent.foreground": "{{colors.on_surface.default.hex}}",
        "sidebar.primary.background": "{{colors.primary.default.hex}}",
        "sidebar.primary.foreground": "{{colors.on_primary.default.hex}}",
        "title_bar.background": "{{colors.surface_container_low.default.hex}}",
        "title_bar.border": "{{colors.outline.default.hex}}33",
        "status_bar.background": "{{colors.surface_container_low.default.hex}}",
        "status_bar.border": "{{colors.outline.default.hex}}33",
        "tab.background": "{{colors.surface.default.hex}}",
        "tab.foreground": "{{colors.on_surface_variant.default.hex}}",
        "tab.active.background": "{{colors.surface_container_high.default.hex}}",
        "tab.active.foreground": "{{colors.on_surface.default.hex}}",
        "tab_bar.background": "{{colors.surface_container_low.default.hex}}",
        "tab_bar.segmented.background": "{{colors.surface_container.default.hex}}",
        "table.background": "{{colors.surface.default.hex}}",
        "table.head.foreground": "{{colors.on_surface_variant.default.hex}}",
        "table.row.border": "{{colors.outline.default.hex}}26",
        "switch.background": "{{colors.surface_variant.default.hex}}",
        "slider.bar.background": "{{colors.primary.default.hex}}",
        "slider.thumb.background": "{{colors.on_primary.default.hex}}",
        "progress_bar.background": "{{colors.primary.default.hex}}",
        "skeleton.background": "{{colors.surface_container_high.default.hex}}",
        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "{{colors.outline.default.hex}}80",
        "scrollbar.thumb.hover.background": "{{colors.outline.default.hex}}",
        "drag_border": "{{colors.primary.default.hex}}",
        "drop_target.background": "{{colors.primary.default.hex}}1a",

        "base.red": "{{colors.terminal_normal_red.default.hex}}",
        "base.red.light": "{{colors.terminal_bright_red.default.hex}}",
        "base.green": "{{colors.terminal_normal_green.default.hex}}",
        "base.green.light": "{{colors.terminal_bright_green.default.hex}}",
        "base.blue": "{{colors.terminal_normal_blue.default.hex}}",
        "base.blue.light": "{{colors.terminal_bright_blue.default.hex}}",
        "base.yellow": "{{colors.terminal_normal_yellow.default.hex}}",
        "base.yellow.light": "{{colors.terminal_bright_yellow.default.hex}}",
        "base.magenta": "{{colors.terminal_normal_magenta.default.hex}}",
        "base.magenta.light": "{{colors.terminal_bright_magenta.default.hex}}",
        "base.cyan": "{{colors.terminal_normal_cyan.default.hex}}",
        "base.cyan.light": "{{colors.terminal_bright_cyan.default.hex}}"
      }
    }
  ]
}
