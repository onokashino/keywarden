post_install() {
  echo 'Start the daemon for your user:  systemctl --user enable --now keywardend'
  echo 'Chromium-based browsers:         kw browser-setup'
  echo 'niri hotkeys:                    /usr/share/keywarden/niri/keywarden.kdl'
}
post_upgrade() {
  echo 'Restart the daemon to use the new version:  systemctl --user restart keywardend'
}
