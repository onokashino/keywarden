# криптокошелёк: карточка, подтверждение мастер-паролем, фраза и адреса из фразы, форма правки
echo t | $B/kw unlock --password-stdin
$B/kw add --type wallet --title "Основной кошелёк" --field "Seed=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about" --field "Addresses=$(printf 'основной: bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu')" --field "Wallet Type=Ledger Nano X" --field "Networks=BTC, ETH"
$B/kw add --type wallet --title "Только ключ" --field "Private Key=0x4c0883a69102937d6231471b5dbb6204fe5129617082792ae468d01a3f362318"
$B/kw wallet addresses
ui
sleep 3
key -M ctrl f -m ctrl
key "Основной"
sleep 1
key -k Down
shot wallet-detail 2
key -M ctrl -M shift r -m shift -m ctrl
shot wallet-auth 1.5
key t -k Return
shot wallet-revealed 3
key -M ctrl e -m ctrl
shot wallet-edit 2.5
key -k Escape
key -M ctrl -k a -m ctrl
key "Только"
sleep 1
key -k Down
key -M ctrl -M shift r -m shift -m ctrl
shot wallet-key 3
$B/kw add --type wallet --title "Ledger наблюдение" --field "Wallet Type=Ledger Nano X" --field "xpub=zpub6rFR7y4Q2AijBEqTUquhVz398htDFrtymD9xYYfG1m4wAcvPhXNfE3EfH1r1ADqtfSdVCToUG868RvUUkgDKf31mGDtKsAYz2oz2AGutZYs"
key -k Escape; key -M ctrl -k a -m ctrl; key "наблюдение"; sleep 1; key -k Down
shot wallet-xpub 2.5
key -M ctrl e -m ctrl; shot wallet-xpub-edit 2.5
$B/kw add --type wallet --title "Опечатка в адресе" --field "Seed=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about" --field "Addresses=bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyv"
$B/kw add --type wallet --title "Битая фраза" --field "Seed=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon"
key -k Escape
key -M alt -k Down -m alt
key -M alt -k Down -m alt
shot wallet-health 3
